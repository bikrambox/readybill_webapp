    public function handle()
    {
        try {
            // Progress key and data key are separate to avoid races
            $progressKey = "excel_fetch_progress_{$this->userId}_{$this->jobId}";
            $dataKey = "excel_fetch_result_{$this->userId}_{$this->jobId}";

            $this->updateProgress(10, __('validation.Starting data fetch') . '...', false, $progressKey);

            // Validate user
            $user = User::find($this->userId);
            if (!$user) {
                $this->cacheErrorResponse(__('validation.User not found'));
                return;
            }

            $this->updateProgress(20, __('validation.Checking temporary table') . '...', false, $progressKey);

            $temp_table_name = ExcelHelpher::createTempTableName($this->userId);
            $preferences = DB::connection($user->module_type)
                ->table('preferences')
                ->where('user_id', $this->userId)
                ->first();

            if (!$preferences) {
                $this->cacheErrorResponse(__('validation.User preferences not found'));
                return;
            }

            if (!Schema::connection($user->module_type)->hasTable($temp_table_name)) {
                $this->cacheErrorResponse(__('validation.No table found, returning empty data'));
                return;
            }

            $this->updateProgress(30, __('validation.Building query') . '...', false, $progressKey);

            // Fetch minimal set
            $allData = DB::connection($user->module_type)->table($temp_table_name)
                ->select([
                    'id',
                    'item_name',
                    'quantity',
                    'min_stock_alert',
                    'mrp',
                    'sale_price',
                    'short_unit',
                    'rate1',
                ])
                ->get();

            // Seed a first snapshot as quickly as possible (optional):
            // Cache::put($dataKey, $this->makeSnapshotSkeleton(), now()->addMinutes(30));

            $itemNames = DB::connection($user->module_type)->table($temp_table_name)
                ->pluck('item_name')
                ->map(fn($name) => strtoupper(trim(ItemHelpher::checkSpecialCharacterFromString($name ?? 'New Item'))))
                ->toArray();

            $data = [];
            $errorMap = [];

            $this->updateProgress(50, __('validation.Validating data') . '...', false, $progressKey);

            foreach ($allData as $key => $row) {
                $rowArray = [
                    'item_name' => $row->item_name,
                    'quantity' => $row->quantity,
                    'min_stock_alert' => $row->min_stock_alert,
                    'mrp' => $row->mrp,
                    'sale_price' => $row->sale_price,
                    'unit' => $row->short_unit,
                    'vat' => $row->rate1,
                ];

                $validationResult = ExcelHelpher::validateRow($rowArray, $preferences, '', $itemNames, $user);
                $flag = !empty($validationResult['errors']) ? 1 : 0;

                if (!empty($validationResult['errors'])) {
                    $errorMap[$key] = $validationResult['errors'];
                }

                $data[] = [
                    'original_index' => $key,
                    'id' => $row->id,
                    'item_name' => $row->item_name,
                    'quantity' => $row->quantity,
                    'min_stock_alert' => $row->min_stock_alert,
                    'mrp' => $row->mrp,
                    'sale_price' => $row->sale_price,
                    'unit' => $row->short_unit,
                    'vat' => $row->rate1,
                    'flag' => $flag,
                ];
            }

            $totalRecords = count($data);

            $this->updateProgress(70, __('validation.Applying filters') . '...', false, $progressKey);

            $searchValue = $this->searchValue ?? null;
            $orderColumnIndex = $this->orderColumn ?? 1;
            $orderDirection = strtolower($this->orderDirection ?? 'asc') === 'desc' ? 'desc' : 'asc';

            $filteredData = $data;
            if (!empty($searchValue)) {
                $needle = mb_strtolower($searchValue);
                $filteredData = array_values(array_filter($data, function ($row) use ($needle) {
                    return (isset($row['item_name']) && mb_stripos((string) $row['item_name'], $needle) !== false)
                        || (isset($row['quantity']) && mb_stripos((string) $row['quantity'], $needle) !== false)
                        || (isset($row['min_stock_alert']) && mb_stripos((string) $row['min_stock_alert'], $needle) !== false)
                        || (isset($row['mrp']) && mb_stripos((string) $row['mrp'], $needle) !== false)
                        || (isset($row['sale_price']) && mb_stripos((string) $row['sale_price'], $needle) !== false)
                        || (isset($row['unit']) && mb_stripos((string) $row['unit'], $needle) !== false)
                        || (isset($row['vat']) && mb_stripos((string) $row['vat'], $needle) !== false);
                }));
            }

            $filteredRecords = count($filteredData);

            $this->updateProgress(80, __('validation.Applying sorting') . '...', false, $progressKey);

            $columns = [
                1 => 'item_name',
                2 => 'quantity',
                3 => 'min_stock_alert',
                4 => 'mrp',
                5 => 'sale_price',
                6 => 'unit',
                7 => 'vat',
            ];
            $orderColumn = $columns[$orderColumnIndex] ?? 'item_name';

            uasort($filteredData, function ($a, $b) use ($orderColumn, $orderDirection) {
                if ($a['flag'] !== $b['flag']) {
                    return $b['flag'] <=> $a['flag'];
                }
                $va = $a[$orderColumn] ?? null;
                $vb = $b[$orderColumn] ?? null;
                if (is_numeric($va) && is_numeric($vb)) {
                    $cmp = $va <=> $vb;
                } else {
                    $cmp = mb_strtolower((string) $va) <=> mb_strtolower((string) $vb);
                }
                if ($orderDirection === 'desc') {
                    $cmp = -$cmp;
                }
                if ($cmp !== 0) {
                    return $cmp;
                }
                if (($a['id'] ?? 0) !== ($b['id'] ?? 0)) {
                    return ($a['id'] ?? 0) <=> ($b['id'] ?? 0);
                }
                return ($a['original_index'] ?? 0) <=> ($b['original_index'] ?? 0);
            });
            $filteredData = array_values($filteredData);

            $this->updateProgress(90, __('validation.Applying pagination') . '...', false, $progressKey);

            $start = max(0, (int) ($this->start ?? 0));
            $length = (int) ($this->length ?? 10);
            $paginatedData = $length < 0 ? $filteredData : array_slice($filteredData, $start, $length);

            $gridColumns = [
                'item_name',
                'quantity',
                'min_stock_alert',
                'mrp',
                'sale_price',
                'unit',
                'vat',
                'flag',
                'id',
                'original_index',
            ];

            $newErrors = ['coordinates' => [], 'grid_coordinates' => [], 'messages' => []];

            foreach ($paginatedData as $newIndex => $row) {
                $originalIndex = $row['original_index'];
                if (isset($errorMap[$originalIndex])) {
                    foreach ($errorMap[$originalIndex] as $field => $errorMessage) {
                        $normalizedField = $field;
                        if ($field === 'short_unit')
                            $normalizedField = 'unit';
                        if ($field === 'rate1')
                            $normalizedField = 'vat';

                        $newErrors['coordinates'][] = "items.$newIndex.$normalizedField";
                        $colIdx = array_search($normalizedField, $gridColumns, true);
                        $colIdx = ($colIdx === false) ? 0 : $colIdx;
                        $newErrors['grid_coordinates'][] = sprintf("%02d,%02d", $newIndex, ($colIdx+1));

                        if (!in_array($errorMessage, $newErrors['messages'], true)) {
                            $newErrors['messages'][] = $errorMessage;
                        }
                    }
                }
            }

            $status = 1;
            $message = empty($errorMap) ? "Data fetched successfully" : "Some rows contain errors";

            $this->updateProgress(95, __('validation.Preparing response') . '...', false, $progressKey);

            // Final response snapshot (this is what the controller/consumer should read)
            $response = [
                'draw' => intval($this->draw),
                'recordsTotal' => $totalRecords,
                'recordsFiltered' => $filteredRecords,
                'data' => array_values($paginatedData),
                'status' => $status,
                'errors' => $newErrors,
                'message' => $message,
            ];

            // Write the final data snapshot
            Cache::put($dataKey, $response, now()->addMinutes(30));

            // Only now mark progress as 100% so clients switch to this snapshot
            $this->updateProgress(100, __('valiadtion.Data fetched successfully'), true, $progressKey);
        } catch (\Exception $e) {
            Log::error('FetchUploadedExcelDataJob failed', [
                'user_id' => $this->userId,
                'job_id' => $this->jobId,
                'error' => $e->getMessage(),
            ]);
            $this->cacheErrorResponse(__('validation.An error occurred while fetching data') . ': ' . $e->getMessage());
        }
    }



    /**
     * Cache an error response.
     */
    protected function cacheErrorResponse($message)
    {
        $response = [
            'draw' => intval($this->draw),
            'recordsTotal' => 0,
            'recordsFiltered' => 0,
            'data' => [],
            'status' => 0,
            'errors' => ['coordinates' => [], 'grid_coordinates' => [], 'messages' => [$message]],
            'message' => $message,
        ];

        Cache::put("excel_fetch_result_{$this->userId}_{$this->jobId}", $response, now()->addMinutes(30));
        $this->updateProgress(100, $message, false);
    }

    /**
     * Update progress cache.
     */
    protected function updateProgress($percentage, $message, $success = null)
    {
        Cache::put("excel_fetch_progress_{$this->userId}_{$this->jobId}", [
            'percentage' => $percentage,
            'message' => $message,
            'success' => $success,
        ], now()->addMinutes(30));
    }
}
