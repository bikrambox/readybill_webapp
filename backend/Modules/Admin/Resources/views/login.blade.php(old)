    <script>
        $(document).ready(function () {
            // form submit
            $('#loginForm').submit(function (e) {
                e.preventDefault();

                var url = $(this).attr('action');
                var method = $(this).attr('method');
                var formData = new FormData(this);
                var error = $('.error');

                error.text("");

                $.ajax({
                    url: url,
                    type: method,
                    data: formData,
                    contentType: false,
                    processData: false,
                    beforeSend: function () {
                        $('#btnSubmit').text("Please wait ...").attr('disabled', true);
                    },
                    success: function (data) {
                        if (data.success) {
                            window.location.replace("{{ route('admin.dashboard') }}");

                        } else {
                            Swal.fire({
                                title: 'Error!',
                                text: data.message,
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        }
                    },
                    complete: function () {
                        $('#btnSubmit').text("Login").attr('disabled', false);
                    },
                    error: function (xhr, status, errorThrown) {
                        // Log error details for debugging
                        console.error("Error details:", {
                            status: status,
                            errorThrown: errorThrown,
                            responseText: xhr.responseText
                        });

                        // Display error message based on status
                        if (xhr.status === 500) {
                            Swal.fire({
                                title: 'Server Error!',
                                text: 'An internal server error occurred. Please try again later.',
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        } else if (xhr.status === 422) {
                            // Handle validation errors (Laravel returns 422 for validation failures)
                            var errors = xhr.responseJSON?.errors;
                            if (errors) {
                                Object.keys(errors).forEach(function (key) {
                                    $(`#${key}-error`).text(errors[key][0]); // Assuming you have error containers with IDs like `mobile-error`
                                });
                            }
                        } else {
                            Swal.fire({
                                title: 'Error!',
                                text: 'An unexpected error occurred. Please try again.',
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        }
                    },
                });
            });
        });

        $(document).ready(function () {
            // Close popup
            $('#popupCloseBtn').on('click', function () {
                $("#popup").addClass('hidden');
            });

            // Toggle navigation menu on small screens
            $('#menuBtn').on('click', function () {
                $('#menuItems').toggleClass('hidden');
            });

            // Optional: Close the menu when clicking outside of it
            $(document).on('click', function (event) {
                if (!$(event.target).closest('#menuBtn, #menuItems').length) {
                    $('#menuItems').addClass('hidden');
                }
            });
        });
    </script>
