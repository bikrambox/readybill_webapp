APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_ENVIRONMENT='local'

# --------------------------------- MULTIPLE DATABASE CONNECTIONS ---------------------------------
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=readybill_central
DB_USERNAME=root
DB_PASSWORD=

GROCERY_INDIA_DB_CONNECTION=grocery_india
GROCERY_INDIA_DB_HOST=127.0.0.1
GROCERY_INDIA_DB_PORT=3306
GROCERY_INDIA_DB_DATABASE=readybill_grocery_india
GROCERY_INDIA_DB_USERNAME=root
GROCERY_INDIA_DB_PASSWORD=


GROCERY_GERMAN_DB_CONNECTION=grocery_germany
GROCERY_GERMAN_DB_HOST=127.0.0.1
GROCERY_GERMAN_DB_PORT=3306
GROCERY_GERMAN_DB_DATABASE=readybill_grocery_german
GROCERY_GERMAN_DB_USERNAME=root
GROCERY_GERMAN_DB_PASSWORD=


