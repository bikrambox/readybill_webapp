# ----------------------------------------------- API VERSION -----------------------------------------------
API_VERSION ="v2"
APP_VERSION = "1.0.0"

GROCERY_INDIA_PREFIX = "in/grocery/"
GROCERY_GERMANY_PREFIX = "de/grocery/"

VITE_GROCERY_INDIA_PREFIX = "in/grocery/"
VITE_GROCERY_GERMANY_PREFIX = "de/grocery/"

ADMIN_PREFIX = "admin-panel"
ADMIN_LOGOUT_URL = "/admin-panel"
