# OTP expiry time
OTP_EXPIRY = 5

# Maximum OPT attempt
OTP_COUNT = 4

# MAXIMUM COUNTDOWN
COUNTDOWN = 60 # 1 MINUTE


AGENT_OTP_EXPIRY_MINUTES=5
AGENT_OTP_COOLDOWN_SECONDS=60
AGENT_OTP_MAX_ATTEMPTS=5
AGENT_OTP_LOCKOUT_MINUTES=15

# ----------------------------------------------- SUBSCRIPTION CONFIGURATIONS -----------------------------------------------
# Subscription Configuration
SUBSCRIPTION_FREE_PLAN_EXPIRY_DAYS = 100 
FREE_SUBSCRIPTION_ID=1
FREE_PLAN_ACCESS=restricted

# Report data access (in years)
FREE_PLAN_REPORT_DATA_YEARS=1
PREMIUM_PLAN_REPORT_DATA_YEARS=3

# ----------------------------------------------- SUBSCRIPTION CONFIGURATIONS -----------------------------------------------


